{
 "new_themes": [
  {
   "id": "c_print",
   "theme": "Hard to print correctly",
   "use_for": "Printing is tricky, pages print wrong, misaligned or not as they should.",
   "kind": "complaints"
  },
  {
   "id": "c_size",
   "theme": "Wrong or missing paper/planner size",
   "use_for": "Needed size (A5, Letter, a planner size) not offered or file formatted for the wrong size.",
   "kind": "complaints"
  },
  {
   "id": "c_repetitive",
   "theme": "Repetitive or duplicate pages",
   "use_for": "Many near-duplicate or redundant pages, not enough variety.",
   "kind": "complaints"
  },
  {
   "id": "c_shipping",
   "theme": "Physical order slow or never arrived",
   "use_for": "Printed or hard-copy order shipped late, got lost or never arrived.",
   "kind": "complaints"
  },
  {
   "id": "w_printed",
   "theme": "Option to buy it printed",
   "use_for": "Would rather pay to have the planner printed and shipped.",
   "kind": "wishes"
  },
  {
   "id": "w_undated",
   "theme": "Undated version",
   "use_for": "Wants an undated version of a dated page or calendar.",
   "kind": "wishes"
  },
  {
   "id": "w_crop_marks",
   "theme": "Crop or trim marks for printing",
   "use_for": "Wants cut, bleed or trim marks so printed pages fit the planner.",
   "kind": "wishes"
  },
  {
   "id": "w_sync",
   "theme": "App and PDF versions that match",
   "use_for": "Wants the companion app and the PDF/note-app version to share the same templates and stay in sync.",
   "kind": "wishes"
  }
 ],
