    "hyperlink",
    "linked",
    "tabs"
   ]
  },
  {
   "id": "undated",
   "name": "Undated version",
   "match": [
    "undated"
   ]
  },
  {
   "id": "dated",
   "name": "Dated for the year",
   "match": [
    "\\b202[5-9]\\b",
    "\\bdated\\b"
   ]
  },
  {
   "id": "multi_year",
   "name": "Covers more than one year",
