{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Design brief: every line points to evidence",
 "type": "object",
 "required": [
  "brief_id",
  "type_id",
  "line",
  "created_at",
  "positioning",
  "must_haves",
  "fixes",
  "unique",
  "look",
  "price",
  "seo",
  "photos",
  "spec"
 ],
 "properties": {
  "brief_id": {
   "type": "string"
  },
  "type_id": {
   "type": "string"
  },
  "line": {
   "type": "string"
  },
  "created_at": {
   "type": "string"
  },
  "positioning": {
   "type": "string",
   "minLength": 20
  },
  "must_haves": {
   "type": "array",
   "minItems": 3,
   "items": {
    "type": "object",
    "required": [
     "id",
     "what",
     "evidence"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "what": {
      "type": "string"
     },
     "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "string",
       "pattern": "^(complaint|praise|wish|feature|price|keyword|listing|market|look):"
      }
     }
    }
   }
  },
  "fixes": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "id",
     "complaint",
     "how",
     "evidence"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "complaint": {
      "type": "string"
     },
     "how": {
      "type": "string"
     },
     "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "string",
       "pattern": "^(complaint|praise|wish|feature|price|keyword|listing|market|look):"
      }
     },
     "modules": {
      "type": "array"
     }
    }
   }
  },
  "unique": {
   "type": "array",
   "minItems": 2,
   "items": {
    "type": "object",
    "required": [
     "id",
     "name",
     "what",
     "why",
     "evidence"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "what": {
      "type": "string"
     },
     "why": {
      "type": "string"
     },
     "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "string",
       "pattern": "^(complaint|praise|wish|feature|price|keyword|listing|market|look):"
      }
     },
     "modules": {
      "type": "array"
     },
     "verified_absent": {
      "type": "boolean"
     }
    }
   }
  },
  "look": {
   "type": "object",
   "required": [
    "direction",
    "theme",
    "avoid"
   ],
   "properties": {
    "direction": {
     "type": "string"
    },
    "theme": {},
    "avoid": {
     "type": "array"
    },
    "evidence": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string",
      "pattern": "^(complaint|praise|wish|feature|price|keyword|listing|market|look):"
     }
    }
   }
  },
  "price": {
   "type": "object",
   "required": [
    "amount",
    "why"
   ],
   "properties": {
    "amount": {
     "type": "number",
     "minimum": 1
    },
    "why": {
     "type": "string"
    },
    "evidence": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string",
      "pattern": "^(complaint|praise|wish|feature|price|keyword|listing|market|look):"
     }
    }
   }
  },
  "seo": {
   "type": "object",
   "required": [
    "title",
    "tags"
   ],
   "properties": {
    "title": {
     "type": "string",
     "maxLength": 140
    },
    "tags": {
     "type": "array",
     "minItems": 13,
     "maxItems": 13,
     "items": {
      "type": "string",
      "maxLength": 20
     }
    }
   }
  },
  "photos": {
   "type": "array",
   "minItems": 5,
   "items": {
    "type": "object",
    "required": [
     "id",
     "shows"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "shows": {
      "type": "string"
     },
     "proves": {
      "type": "string"
     },
     "pages": {
      "type": "array"
     }
    }
   }
  },
  "spec": {
   "type": "object"
  },
  "waived": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "ref",
     "reason"
    ],
    "properties": {
     "ref": {
      "type": "string"
     },
     "reason": {
      "type": "string",
      "minLength": 15
     }
    }
   }
  },
  "new_modules": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "name",
     "what",
     "params",
     "why"
    ]
   }
  },
  "product_id": {
   "type": "string"
  }
 }
}